# -----------------------------------------------------------
# Helper Function: Unpaired PERMANOVA + Pairwise PERMANOVA
# -----------------------------------------------------------
#
# Purpose:
# Test for overall beta diversity differences among independent
# groups using PERMANOVA, followed by pairwise PERMANOVA comparisons.
#
# Pairwise P-values are adjusted using the Benjamini–Hochberg (BH)
# procedure to account for multiple pairwise comparisons.
#
# This version does not constrain permutations by a stratification
# variable and is therefore used for unpaired group comparisons.
#
# Arguments:
#   dist_matrix  = beta diversity distance matrix
#   name         = name of the distance metric
#   group_vector = grouping variable

run_permanova <- function(dist_matrix, name, group_vector) {
  
  cat("\n=======================================\n")
  cat(" PERMANOVA Results: ", name, "\n")
  cat("=======================================\n")
  
  # Set seed to ensure reproducible permutation results.
  set.seed(123)
  
  # Run the global PERMANOVA.
  permanova <- adonis2(
    dist_matrix ~ group_vector,
    permutations = 999
  )
  print(permanova)
  
  # Run pairwise PERMANOVA comparisons.
  cat("\nPairwise PERMANOVA:\n")
  pairwise <- pairwise.adonis(
    dist_matrix,
    factors = group_vector,
    perm = 999,
    p.adjust.m = "BH"
  )
  
  print(pairwise)
}



# ------------------------------------------------
# Helper Function: PCoA Plot (Akha)
# ------------------------------------------------
#
# Purpose:
# Visualize PCoA ordination for Akha samples, with samples
# colored by study group and 95% confidence ellipses.
#
# Arguments:
#   ord        = PCoA ordination object
#   ps_Akha    = Akha phyloseq object
#   method_name = ordination method label
#   dist_name  = beta diversity distance metric name

plot_pcoa_Akha <- function(ord, ps_Akha, method_name, dist_name) {
  
  plot_ordination(ps_Akha, ord, color = "Group") +
    geom_point(size = 2) +
    stat_ellipse(aes(color = Group), level = 0.95) +
    scale_color_manual(
      name = "Group",
      values = c(
        "Akha-CM" = "gold1",
        "Akha-CR" = "dodgerblue4"
      )
    ) +
    labs(
      title = paste("PCoA -", dist_name),
      x = paste0("PCoA1 (", round(100 * ord$values$Relative_eig[1], 2), "%)"),
      y = paste0("PCoA2 (", round(100 * ord$values$Relative_eig[2], 2), "%)")
    ) +
    theme_bw() +
    theme(
      panel.grid = element_blank(),
      plot.title = element_text(size = 10),
      legend.position = "right"
    )
}



