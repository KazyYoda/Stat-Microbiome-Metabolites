# ------------------------------------------------
# Helper Function: Beta Dispersion Plot (Akha)
# ------------------------------------------------
#
# Purpose:
# Assess homogeneity of multivariate dispersion among Akha
# groups and visualize the distance of individual samples
# from their corresponding group centroid.
#
# The permutation test evaluates whether the degree of dispersion
# differs among groups.
#
# Arguments:
#   dist     = beta diversity distance matrix
#   grouping = grouping variable
#   method   = name of the distance metric
#   sqrt     = whether to apply square-root transformation
#              before beta dispersion analysis

plot_betadisper_Akha <- function(dist, grouping, method, sqrt = FALSE) {
  
  cat("\n==================================================\n")
  cat(" Beta-Dispersion Results: ", method, "\n")
  cat("==================================================\n")
  
  # Calculate multivariate dispersion for each group.
  disp <- betadisper(dist, grouping, sqrt.dist = sqrt)
  
  # Set seed to ensure reproducibility of the permutation test.
  set.seed(123)
  
  # Test for differences in multivariate dispersion among groups.
  print(permutest(disp, permutations = 999))
  
  # Prepare distances to group centroids for visualization.
  df <- data.frame(
    Group    = disp$group,
    Distance = disp$distances
  )
  
  # Visualize distances to group centroids using boxplots.
  p <- ggplot(df, aes(x = Group, y = Distance, fill = Group)) +
    geom_boxplot() +
    labs(
      title = paste("Beta Dispersion -", method),
      y = "Distance to centroid"
    ) +
    scale_fill_manual(
      name = "Group",
      values = c(
        "Akha-CM" = "gold1",
        "Akha-CR" = "dodgerblue4"
      )
    ) +
    theme_bw() +
    theme(
      panel.grid = element_blank(),
      plot.title = element_text(size = 9),
      legend.position = "right"
    )
  
  return(p)
}



