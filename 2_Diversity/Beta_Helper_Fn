############################################################
# Helper Functions: Beta Diversity Analysis
############################################################
#
# This script contains reusable functions for:
#   1. Stratified PERMANOVA for paired/blocked comparisons
#   2. Pairwise stratified PERMANOVA
#   3. Unpaired PERMANOVA with BH-adjusted pairwise comparisons
#   4. PCoA visualization
#   5. Beta dispersion analysis and visualization
#
# The functions are used by the beta diversity analysis scripts
# to maintain a consistent statistical and visualization workflow.


# ------------------------------------------------
# Helper Function: Stratified PERMANOVA
# ------------------------------------------------
#
# Purpose:
# Test for differences in beta diversity between groups while
# restricting permutations within levels of a stratification
# factor (e.g., location or subject).
#
# This approach is appropriate when the study design includes
# paired or blocked observations and permutations should not
# occur freely across the strata.
#
# Arguments:
#   dist_matrix  = beta diversity distance matrix
#   name         = name of the distance metric
#   group_vector = grouping variable of interest
#   strata       = stratification/blocking variable

run_permanova <- function(dist_matrix, name, group_vector, strata) {
  
  cat("\n=======================================\n")
  cat(" PERMANOVA Results: ", name, "\n")
  cat("=======================================\n")
  
  # Set seed to ensure reproducible permutation results.
  set.seed(123)
  
  # Run PERMANOVA with permutations constrained within strata.
  permanova <- adonis2(
    dist_matrix ~ group_vector,
    permutations = 999,
    strata = strata
  )
  
  print(permanova)
}



# ------------------------------------------------
# Helper Function: Pairwise Stratified PERMANOVA
# ------------------------------------------------
#
# Purpose:
# Perform pairwise PERMANOVA comparisons between all possible
# combinations of groups while maintaining the specified
# permutation restriction within strata.
#
# The function returns a list containing the PERMANOVA result
# for each pairwise group comparison.
#
# Arguments:
#   dist_matrix  = beta diversity distance matrix
#   group_vector = grouping variable
#   strata       = stratification/blocking variable

pairwise_stratified <- function(dist_matrix, group_vector, strata) {
  
  groups <- levels(group_vector)
  results <- list()
  
  # Iterate through all unique combinations of groups.
  for (i in 1:(length(groups) - 1)) {
    for (j in (i + 1):length(groups)) {
      
      # Identify samples belonging to the current pair of groups.
      idx <- group_vector %in% c(groups[i], groups[j])
      
      # Subset the distance matrix, grouping variable, and
      # stratification variable to the current comparison.
      sub_dist   <- as.dist(as.matrix(dist_matrix)[idx, idx])
      sub_group  <- droplevels(group_vector[idx])
      sub_strata <- droplevels(strata[idx])
      
      # Run pairwise PERMANOVA with permutations constrained
      # within the specified strata.
      res <- adonis2(
        sub_dist ~ sub_group,
        permutations = 999,
        strata = sub_strata
      )
      
      # Store the result using the group comparison as the list name.
      results[[paste(groups[i], "vs", groups[j])]] <- res
    }
  }
  
  return(results)
}


