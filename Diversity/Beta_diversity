Lahu_unw  <- distance(ps_Lahu, method = "unifrac", weighted = FALSE)
Lahu_w    <- distance(ps_Lahu, method = "unifrac", weighted = TRUE)
Lahu_bray <- distance(ps_Lahu, method = "bray")



# ------------------------------
# Ordination: PCoA
