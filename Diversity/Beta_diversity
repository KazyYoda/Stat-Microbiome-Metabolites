# composition among Lahu samples.
Lahu_unw_pcoa  <- ordinate(ps_Lahu, method = "PCoA", distance = Lahu_unw)
Lahu_w_pcoa    <- ordinate(ps_Lahu, method = "PCoA", distance = Lahu_w)
Lahu_bray_pcoa <- ordinate(ps_Lahu, method = "PCoA", distance = Lahu_bray)



# ------------------------------
