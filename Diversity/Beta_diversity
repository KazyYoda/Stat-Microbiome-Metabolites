p2

# Generate a PCoA plot based on Bray–Curtis.
p3 <- plot_pcoa_Lahu(Lahu_bray_pcoa, ps_Lahu, "PCoA", "Bray-Curtis")
p3



# ------------------------------------------------
# PERMANOVA and Pairwise PERMANOVA
# ------------------------------------------------
#
# PERMANOVA tests whether overall community composition differs
# between Lahu-CM and Lahu-CR based on each distance matrix.
#
# The grouping variable is explicitly ordered to ensure consistent
# group labeling throughout the analysis.


# Define the grouping variable for the two study areas.
grouping <- factor(
  sample_data(ps_Lahu)$Group,
  levels = c("Lahu-CM", "Lahu-CR")
