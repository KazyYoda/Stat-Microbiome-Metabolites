# Arrange the PCoA and corresponding beta dispersion plots
# side by side for each distance metric.
#
# Left column  = PCoA
# Right column = beta dispersion

grid.arrange(
  p1, d1,
  p2, d2,
  p3, d3,
  ncol = 2,
  nrow = 3
)








