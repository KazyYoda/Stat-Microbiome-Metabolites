run_permanova(Lahu_unw,  "Unweighted UniFrac", grouping)
run_permanova(Lahu_w,    "Weighted UniFrac", grouping)
run_permanova(Lahu_bray, "Bray-Curtis", grouping)



# ------------------------------------------------
# Beta Dispersion Analysis
# ------------------------------------------------
#
# Objective:
# Assess the homogeneity of multivariate dispersion between
# Lahu-CM and Lahu-CR to support interpretation of the PERMANOVA
# results.


# Assess beta dispersion using Unweighted UniFrac.
d1 <- plot_betadisper_Lahu(Lahu_unw, grouping, "Unweighted UniFrac")
d1

# Assess beta dispersion using Weighted UniFrac.
d2 <- plot_betadisper_Lahu(Lahu_w, grouping, "Weighted UniFrac", sqrt = TRUE)
d2

# sqrt = TRUE:
